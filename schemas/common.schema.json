{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json",
  "title": "ALP v0.1 common definitions",
  "$defs": {
    "version": {
      "const": "0.1",
      "description": "Protocol version carried in the `alp` member."
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "ULID: 26 Crockford base32 characters, upper case."
    },
    "timestamp": {
      "type": "string",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$",
      "description": "RFC 3339 date-time in UTC with a Z suffix and at most millisecond precision."
    },
    "domain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "not": {
        "pattern": "\\.\\."
      },
      "description": "Lower-case DNS name in A-label form, at least two labels, no trailing dot."
    },
    "address": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^alp:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "not": {
        "pattern": "\\.\\."
      },
      "description": "Principal address in protocol form: alp:local@domain, lower case."
    },
    "delegate_label": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,30}[a-z0-9])?$"
    },
    "delegate_id": {
      "type": "string",
      "maxLength": 360,
      "pattern": "^alp:[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?/[a-z0-9](?:[a-z0-9_-]{0,30}[a-z0-9])?$",
      "not": {
        "pattern": "\\.\\."
      },
      "description": "The principal's address, a slash and the delegate label."
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,64}$",
      "description": "Immutable, never-reused principal identifier issued by the home broker."
    },
    "broker_id": {
      "type": "string",
      "maxLength": 270,
      "pattern": "^https://[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?(?::[0-9]{1,5})?$",
      "description": "A broker's HTTPS origin: scheme, lower-case host and optional port; no path, no trailing slash."
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Za-z0-9_-]{43}$",
      "description": "sha256: followed by the unpadded base64url SHA-256 digest."
    },
    "jkt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "RFC 7638 JWK SHA-256 thumbprint, base64url."
    },
    "detached_jws": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$",
      "description": "RFC 7515 Appendix F detached compact JWS: protected header, empty payload, signature."
    },
    "scope_id": {
      "type": "string",
      "maxLength": 330,
      "pattern": "^(?:alp\\.[a-z][a-z0-9_]{0,63}|org\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9_]{0,63})/[1-9][0-9]{0,3}$"
    },
    "message_type": {
      "enum": [
        "request",
        "propose",
        "counter",
        "accept",
        "decline",
        "inform",
        "ask_human",
        "commit",
        "ack",
        "error"
      ]
    },
    "control_type": {
      "enum": [
        "connection_request",
        "connection_response",
        "revoke"
      ]
    },
    "pointer": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:/body(?:/(?:[^/~]|~[01])*)*|/note)$",
      "description": "Envelope-relative JSON pointer pattern (RFC 6901; a token * matches any one token)."
    },
    "label": {
      "type": "string",
      "maxLength": 132,
      "pattern": "^[a-z][a-z0-9_]{0,31}(?:\\.[a-z][a-z0-9_]{0,31}){0,3}$"
    },
    "label_pattern": {
      "type": "string",
      "maxLength": 134,
      "pattern": "^(?:\\*|[a-z][a-z0-9_]{0,31}(?:\\.[a-z][a-z0-9_]{0,31}){0,3}(?:\\.\\*)?)$"
    },
    "attestation": {
      "enum": [
        "self",
        "vendor",
        "native",
        "org-client",
        "tenant"
      ],
      "description": "Ordered self < vendor < native < org-client < tenant."
    },
    "class": {
      "enum": [
        "consumer",
        "business",
        "enterprise"
      ],
      "description": "Ordered consumer < business < enterprise."
    },
    "error_code": {
      "enum": [
        "invalid_input",
        "identity_mismatch",
        "unknown_scope",
        "unknown_type",
        "schema_invalid",
        "body_too_large",
        "no_relationship",
        "type_not_allowed",
        "not_disclosed",
        "org_policy",
        "federation_blocked",
        "client_not_allowed",
        "blocked",
        "dlp_blocked",
        "rate_limited",
        "thread_state",
        "needs_ratification",
        "unknown_recipient",
        "discovery_failed",
        "unreachable",
        "expired",
        "bad_envelope",
        "unsupported_version",
        "bad_signature",
        "wrong_audience",
        "replay",
        "broker_not_authorized",
        "not_accepted",
        "constraints_unsupported",
        "internal"
      ]
    },
    "dlp_category": {
      "enum": [
        "payment_card",
        "private_key",
        "credential",
        "government_id"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "principal_id"
      ],
      "properties": {
        "address": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/address"
        },
        "principal_id": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/principal_id"
        },
        "delegate": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/delegate_id"
        },
        "attestation": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/attestation"
        },
        "class": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/class"
        }
      },
      "dependentRequired": {
        "delegate": [
          "attestation",
          "class"
        ],
        "attestation": [
          "delegate"
        ],
        "class": [
          "delegate"
        ]
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/address"
        },
        "principal_id": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/principal_id"
        },
        "delegate": {
          "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/delegate_id"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "redacted",
        "policy_ids"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "allowed",
            "redacted"
          ]
        },
        "redacted": {
          "type": "array",
          "items": {
            "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/pointer"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "policy_ids": {
          "type": "array",
          "items": {
            "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/policy_id"
          },
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "allowed"
              }
            }
          },
          "then": {
            "properties": {
              "redacted": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "redacted"
              }
            }
          },
          "then": {
            "properties": {
              "redacted": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "deliver_to": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "min_attestation": {
              "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/attestation"
            },
            "min_class": {
              "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/class"
            }
          },
          "minProperties": 1
        },
        "no_training": {
          "const": true
        },
        "retention_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Days."
        }
      },
      "minProperties": 1
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "per_seconds"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "per_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        }
      }
    },
    "quiet_hours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tz",
        "start",
        "end"
      ],
      "properties": {
        "tz": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        "start": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "principal_ref": {
      "type": "string",
      "maxLength": 340,
      "pattern": "^(?:\\*|@org|group:[a-z][a-z0-9_-]{0,63}|alp:(?:\\*|[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?)@(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?)$",
      "description": "An exact address, alp:*@domain, group:<name>, @org (any principal of the policy's domains) or * (anyone)."
    },
    "domain_pattern": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    }
  }
}
