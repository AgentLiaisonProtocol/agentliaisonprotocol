{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/envelope.schema.json",
  "title": "ALP envelope (JWS typ alp-envelope+jws)",
  "description": "A message between two principals in one scope. Body schemas for request, propose, counter, accept, inform and commit come from the scope definition; ack, decline, error and ask_human bodies are protocol-defined.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alp",
    "id",
    "thread",
    "from",
    "to",
    "aud",
    "scope",
    "type",
    "body",
    "grant",
    "labels",
    "created_at",
    "expires_at",
    "origin_broker",
    "decision",
    "broker_sig"
  ],
  "properties": {
    "alp": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/version"
    },
    "id": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/ulid"
    },
    "thread": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/ulid"
    },
    "in_reply_to": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/ulid"
    },
    "in_reply_to_hash": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/sha256"
    },
    "from": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/sender"
    },
    "to": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/recipient"
    },
    "aud": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/broker_id"
    },
    "scope": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/scope_id"
    },
    "type": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/message_type"
    },
    "body": {
      "type": "object",
      "maxProperties": 64
    },
    "note": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/note"
    },
    "terms_hash": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/sha256"
    },
    "ratifications": {
      "type": "array",
      "items": {
        "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/sha256"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "grant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/label"
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    },
    "constraints": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/constraints"
    },
    "created_at": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/timestamp"
    },
    "origin_broker": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/broker_id"
    },
    "decision": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/decision"
    },
    "broker_sig": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/detached_jws"
    }
  },
  "dependentRequired": {
    "in_reply_to": [
      "in_reply_to_hash"
    ],
    "in_reply_to_hash": [
      "in_reply_to"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "accept",
              "commit"
            ]
          }
        }
      },
      "then": {
        "required": [
          "terms_hash"
        ]
      },
      "else": {
        "properties": {
          "terms_hash": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "commit"
          }
        }
      },
      "then": {
        "required": [
          "ratifications"
        ]
      },
      "else": {
        "properties": {
          "ratifications": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "counter",
              "accept",
              "decline",
              "ack",
              "commit"
            ]
          }
        }
      },
      "then": {
        "required": [
          "in_reply_to"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ack"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/messages/ack.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "decline"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/messages/decline.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/messages/error.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ask_human"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/messages/ask_human.schema.json"
          }
        }
      }
    }
  ]
}
