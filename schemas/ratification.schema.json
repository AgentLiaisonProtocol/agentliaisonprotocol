{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/ratification.schema.json",
  "title": "ALP ratification record (JWS typ alp-ratification+jws)",
  "description": "A principal's ratification of agreed terms, made on their own home broker. It travels inside an ack body (status ratified) and is referenced by hash from the commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alp",
    "id",
    "thread",
    "scope",
    "terms_hash",
    "principal_id",
    "address",
    "method",
    "iat",
    "nonce",
    "created_at",
    "expires_at",
    "origin_broker",
    "aud",
    "broker_sig"
  ],
  "properties": {
    "alp": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/version"
    },
    "id": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/ulid"
    },
    "thread": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/ulid"
    },
    "scope": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/scope_id"
    },
    "terms_hash": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/sha256"
    },
    "principal_id": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/principal_id"
    },
    "address": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/address"
    },
    "method": {
      "anyOf": [
        {
          "enum": [
            "webauthn-uv",
            "sso-stepup",
            "native-uv",
            "reauth-dev"
          ]
        },
        {
          "type": "string",
          "pattern": "^standing-grant:[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      ]
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,86}$"
    },
    "created_at": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/timestamp"
    },
    "origin_broker": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/broker_id"
    },
    "aud": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/broker_id"
    },
    "broker_sig": {
      "$ref": "tag:agentliaisonprotocol.org,2026-11-08:spec/0.1/schemas/common.schema.json#/$defs/detached_jws"
    }
  }
}
