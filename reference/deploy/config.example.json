{
  "id": "https://broker.example.org",
  "domains": ["example.org"],
  "policies": ["policy.example.json"],
  "identity": {
    "kind": "dev",
    "identities": [
      { "username": "ana", "address": "alp:ana@example.org", "display_name": "Ana (test analyst)" },
      { "username": "lee", "address": "alp:lee@example.org", "display_name": "Lee (test leader)" }
    ]
  },
  "identity_examples": {
    "oidc": {
      "kind": "oidc",
      "provider": "generic",
      "issuer": "https://idp.example.org",
      "client_id": "alp-broker",
      "client_auth": "client_secret_basic",
      "scopes": ["openid", "profile", "email", "offline_access"],
      "address_claim": "email",
      "require_verified_email": true,
      "group_claims": ["groups"],
      "domains": ["example.org"],
      "refresh_check": true,
      "fresh_sign_in": true
    },
    "entra": {
      "kind": "oidc",
      "provider": "entra",
      "tenant": "00000000-0000-0000-0000-000000000000",
      "client_id": "11111111-1111-1111-1111-111111111111",
      "client_auth": "client_secret_post",
      "scopes": ["openid", "profile", "email", "offline_access"],
      "address_claim": "preferred_username",
      "group_claims": ["roles"],
      "allow_guests": false,
      "refresh_check": true,
      "fresh_sign_in": true
    },
    "entra_multi_tenant": {
      "kind": "oidc",
      "provider": "entra",
      "tenant": "organizations",
      "tenants": {
        "00000000-0000-0000-0000-000000000000": ["example.org"]
      },
      "client_id": "11111111-1111-1111-1111-111111111111",
      "address_claim": "preferred_username",
      "group_claims": ["roles"]
    }
  },
  "federation": false
}
